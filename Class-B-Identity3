產地": "熱帶非洲", "特徵": "大型灌木或小喬木，葉油亮具光澤；花白色，略具清香味道，果成熟由綠轉紅，內含2粒種子，可加工成咖啡，為重要的經濟作物；形態優美特殊，具觀賞效果，亦為常見的景觀植栽", "用途": "具中度耐蔭性，一般庭院栽培（宜林下栽種）", "生態": "果可誘引鳥類、哺乳類，果熟成後採收處理成咖啡豆"}}, {"name": "華八仙", "fields": {"科別/生活型": "虎耳草科（or 八仙花科）", "原產地": "華南、琉球、台灣", "特徵": "常綠灌木，葉狹長，莖柔弱多分枝，花色為黃綠色，外被4枚圓形白色的瓣狀萼片，花期春季；耐蔭性佳，通常分布於樹冠下層林帶邊緣等遮蔭環境", "用途": "一般庭院栽培、林下生態地營造", "生態": "花為林下理想之蜜源"}}, {"name": "馬茶花", "fields": {"科別/生活型": "夾竹桃科", "原產地": "印度、緬甸、馬來西亞（外來種）", "特徵": "葉對生、葉表光滑，花頂生或腋出，花色白，具淡清香味；全株具毒性。花期春、夏", "用途": "適陽性至中度遮蔭，一般庭院景觀栽培"}}, {"name": "千年木", "fields": {"科別/生活型": "龍舌蘭科常綠灌木至小喬木", "原產地": "馬達加斯加", "特徵": "莖幹圓直、具肉質構造，葉細長、輪狀互生，簇集生於莖枝頂端叢生；通常生長較為緩慢，耐旱、抗風性具佳；亦耐強日照", "用途": "中度耐蔭，適宜種於林冠或牆角邊緣，一般庭院、盆栽"}}, {"name": "立鶴花", "fields": {"科別/生活型": "爵床科", "原產地": "西非、印度", "特徵": "分枝多、枝條細、易下垂，花筒狀單生腋出，色紫白，台灣地區四季都開花，但以夏秋季較盛開；喜陽性環境，遮蔭環境表現較差", "用途": "一般庭院、盆栽，亦有修剪成綠籬"}}, {"name": "春不老", "fields": {"科別/生活型": "紫金牛科", "原產地": "海南、中南半島、斯里蘭卡、菲律賓，台灣地區自然分布於綠島、蘭嶼", "特徵": "葉肉質，新芽新葉略帶紅色，耐修剪；花小型；果熟成由綠轉紅至紫黑色。耐風、耐蔭、耐貧瘠，適合各式環境栽種", "用途": "一般庭院、綠籬；適半蔭性環境栽植", "生態": "果熟成後具良好誘鳥機能", "繁殖方法": "播種、扦插"}}, {"name": "番茉莉", "fields": {"科別/生活型": "茄科，常綠灌木", "原產地": "巴西、委內瑞拉", "特徵": "花萼筒狀，初開時藍紫色，後轉為白色，具清淡香氣。花期春、夏季。植株具毒性", "用途": "一般庭院栽植、綠籬、盆栽"}}, {"name": "白水木", "fields": {"科別/生活型": "紫草科", "原產地": "熱帶亞洲、馬達加斯加、馬來西亞、熱帶澳洲及太平洋諸島；台灣自然分布於恆春半島、蘭嶼、小琉球及綠島", "特徵": "常綠性的灌木或小喬木，樹皮灰褐色，葉簇集在枝端，葉片、花序都被有銀白色的絨毛。海岸第一線分布的植物，對不良環境適應性極佳", "用途": "廣泛用於一般庭院栽培、盆栽，或濱海綠化栽植", "生態": "花具蜜源效果，海岸生態布置適合樹種"}}, {"name": "藍雪花", "fields": {"科別/生活型": "藍雪科", "原產地": "南非", "特徵": "枝條伸長呈半蔓性，易下垂；花序頂生，淺藍或淡紫色，花期幾乎全年開放，以夏季及冬季尤盛", "用途": "一般庭院、綠籬，灌叢", "繁殖方法": "扦插"}}, {"name": "燈稱花", "fields": {"科別/生活型": "冬青科，落葉灌木", "原產地": "中國、菲律賓、台灣", "特徵": "落葉灌木，枝幹平滑，上佈淺色斑點。花小型白色，花梗纖細。果熟成後呈紫黑色。分布極廣，自平地至中海拔林下、林地邊緣、甚至開闊地皆常可見", "用途": "全日照至半遮蔭環境皆可適應，喜分布在林緣交界或林下空間。形態優美，適一般庭園景觀種植", "生態": "果具引誘山鳥的功效", "繁殖方法": "實生"}}, {"name": "香冠柏（金冠柏）", "fields": {"科別/生活型": "柏科常綠灌木至小喬木", "原產地": "中國、印度、日本（外來種）", "特徵": "常綠灌木或小喬木，主幹明顯細直，分枝性強，小枝環繞密生。針葉細密、具特殊檸檬芳香。樹形尖錐，樹姿優美，為極佳的景觀樹種", "用途": "喜陽性日照強、冷涼之環境，適用於一般庭園栽培"}}, {"name": "含笑花", "fields": 