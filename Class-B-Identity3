根植物，葉狹長狀似韭菜，花紫色、花期長，於夏秋暖季盛花，喜溫暖、乾燥日照良好的環境，冬季植株生長停滯", "用途": "適一般庭院、花壇栽植", "繁殖方法": "分株、播種"}}, {"name": "馬利筋", "fields": {"科別/生活型": "蘿藦科，多年生草本", "原產地": "熱帶美洲地區（外來種）", "特徵": "莖半木質化，葉對生、長橢圓狀披針狀，花黃or紅色。蓇葖果鶴嘴形，種子有白色纖毛附著，便於飛行散佈，全株含白色乳汁（有毒植物）。喜陽性溫暖環境", "用途": "一般庭院栽培、生態復育環境規劃利用", "生態": "花為蝶類昆蟲喜愛之蜜源，葉供樺斑蝶幼蟲食草", "繁殖方法": "實生或扦插"}}, {"name": "小蚌蘭", "fields": {"科別/生活型": "鴨跖草科", "原產地": "園藝栽培種（蚌蘭原產於西印度群島、墨西哥、瓜地馬拉）", "特徵": "葉小、密生，葉背成紅紫色，葉簇生密集，不易開花。生性強健，耐旱性強，適輕度遮蔭環境", "用途": "適一般庭院，屋頂、栽植槽、花壇", "繁殖方法": "分株法"}}, {"name": "蜘蛛抱蛋", "fields": {"科別/生活型": "百合科", "原產地": "中國、日本、喜馬拉雅山地區（外來種）", "特徵": "根狀莖匍匐於地表或淺層土壤，地上無明顯的莖部，葉、花皆自根狀莖節處抽出，花近地生，花被八枚，似蜘蛛背負卵囊狀而得名。喜陰暗至半陰暗環境", "用途": "適一般庭院地被、盆栽"}}, {"name": "射干", "fields": {"科別/生活型": "鳶尾科，多年生宿根草本", "原產地": "中國、印度、日本、韓國、琉球、蘇聯（外來種）", "特徵": "根狀莖呈結節狀、橫走，地上莖直立；葉扁平。花橘黃色，佈暗紅色斑點，花期近秋冬季。蒴果開裂後露出黑色種子。適應性佳，喜溫暖、陽光充足的環境", "用途": "適一般庭院及花壇栽培", "生態": "蜜源植物"}}, {"name": "帝王蔓綠絨", "fields": {"科別/生活型": "天南星科", "原產地": "園藝雜交種（原生種分布在熱帶至亞熱帶美洲地區）", "特徵": "葉大型，生長較其他蔓綠絨類直立（可做直立植株栽培），莖具氣根，生長速度緩慢，略具攀緣特性，性喜陰暗至半陰暗環境", "用途": "適一般庭院栽植、盆栽"}}, {"name": "孔雀竹芋", "fields": {"科別/生活型": "竹芋科（或葛鬱金科）", "原產地": "熱帶美洲及印度洋島域", "特徵": "多年生常綠草本，具根莖構造，葉銀白色底，從中脈放射出綠色斑條，葉背有同樣形狀的褐紅色斑。喜高溫、濕潤環境，冬季葉色轉暗淡，葉片捲縮", "用途": "適一般庭院、盆栽", "繁殖方法": "分株"}}, {"name": "法國秋海棠", "fields": {"科別/生活型": "秋海棠科", "原產地": "巴西（外來種）", "特徵": "葉略呈長三角形或歪心臟形，葉緣有波狀鋸齒。葉面銅綠，芯葉及葉背呈紅褐色，花色紅艷怡人，花期長、適應性佳，極具景觀效益。喜溫暖、日照充足環境", "用途": "適一般庭院景觀栽植", "繁殖方法": "扦插法"}}, {"name": "山月桃", "fields": {"科別/生活型": "薑科", "原產地": "菲律賓、日本、琉球；台灣分布於全島中低海拔林下", "特徵": "多年生草本，地下莖匍匐蔓生，狀似薑。植株低矮，葉廣披針形，葉表光滑油亮，具短葉柄，由葉鞘包覆成假莖，自莖基抽出；花小型，果小球形，熟成時轉橙紅色，皆具觀賞效益。喜陰暗至半陰暗環境，耐風性佳", "用途": "適一般庭院或林下布置（地被）"}}, {"name": "閉鞘薑", "fields": {"科別/生活型": "薑科，宿根性草本", "原產地": "華南、亞洲熱帶地區、台灣", "特徵": "莖存在二種型態：地下有塊狀根莖；地上草質莖自地下根莖抽出，葉片螺旋狀排列；花頂生，苞片紅或綠色。喜生長林蔭下，受到日照的時間短，葉子便發展出螺旋梯一般，以增加葉面光照面積", "用途": "適一般庭院栽植（地被）", "繁殖方法": "分根法（分切根莖）、地上莖扦插法"}}, {"name": "繁星花", "fields": {"科別/生活型": "茜草科", "原產地": "熱帶非洲、馬達加斯加、阿拉伯半島", "特徵": "一、二年生或多年生草本，全株被有細茸毛。花序呈聚散排列，小花筒狀，花冠五裂，具多種園藝品種。喜日照充足環境", "用途": "適一般庭院栽培、盆栽、花壇", "生態": "重要的蜜源植物，一般生態復育布置適用"}}, {"name": "翠蘆莉", "fields": {"科別/生活型": "爵床科，多年生草本", "原產地": "墨西哥", "特徵": "地下具根莖，水平橫向生長，芽向上長出地上莖，地上莖略呈方形；花以紫或淡紫色為多，亦有粉或白色，花期極長，幾乎全年可見開花。以全日照較佳，但半日照環境表現亦可，環境不拘，乾地或水域濕土適應性皆可。分高性及矮性二類", "用途": "適一般庭院、野地栽培", "生態": "蜜源植物", "繁殖方法": "扦插、播種"}}, {"name": "山蘇", "fields": {"科別/生活型": "鐵角蕨科，蕨類植物", "原產地": "分布地及廣，非洲至玻里尼西亞島嶼、澳洲、東南亞，台灣廣見於全島中低海拔林間、綠島、蘭嶼", "特徵": "莖短促而粗，葉自地下莖簇生，由中心向四方開展而成巢狀。根系綿密，附生於樹幹、岩牆或設施物上，可吸收空氣中水氣營生；對乾旱適性極佳", "用途": "適一般庭院、野地栽培（盆栽、附生、地被）", "生態": "嫩葉可供葉菜佐食", "繁殖方法": "孢子繁殖"}}, {"name": "花丁子", "fields": {"科別/生活型": "玄蔘科，多年生草本植物", "原產地": "墨西哥（外來種）", "特徵": "葉片小、心形，多數幾乎退化；莖呈細長密叢狀枝，容易伏倒下垂，宜栽培較高地勢，倒伏後成垂懸狀，花短筒狀，色艷紅，花期長，除冬季外皆能開花。喜日照良好環境，耐旱性佳", "用途": "適花壇、花台栽植、盆栽", "繁殖方法": "扦插、分株"}}, {"name": "蔥蘭", "fields": {"科別/生活型": "石蒜科，多年生常綠草本", "原產地": "墨西哥、南美洲", "特徵": "地下不膨大鱗莖，具貯藏功能，葉細圓如蔥葉，花頂生，花色白或黃色，花期長，夏至秋季開花。生性健壯、適應性佳，植株具毒性", "用途": "適花壇、盆栽。全株有毒", "生態": "蜜源、葉為石蒜天蛾幼蟲食草"}}, {"name": "玉簪", "fields": {"科別/生活型": "百合科，多年生宿根草本", "原產地": "中國、日本", "特徵": "地下有多數鬚狀根，具貯藏功能；莖短促，葉大型、簇生，多數品系有斑紋、具觀賞性；花白色，具清淡香氣。屬典型蔭性植物，喜陰濕環境，受強光照射葉片易黃化", "用途": "盆栽、地被、林下栽植", "繁殖方法": "分株或播種"}}, {"name": "小天堂鳥（黃麗鳥蕉）", "fields": {"科別/生活型": "旅人蕉科，多年生草本植物", "原產地": "巴西（外來種）", "特徵": "地下具粗壯肉質貯藏根；地下莖球型、短促，葉自短莖叢生抽生，地上部由葉鞘包被形成假莖。花莖自葉腋抽出，花色黃、橙或紅色。全日照或半日照環境皆可適應", "用途": "適一般庭院景觀栽植", "繁殖方法": "分株"}}]}, {"name": "地被", "items": [{"name": "馬鞍藤", "fields": {"科別/生活型": "旋花科，多年生匍匐性草本", "原產地": "廣佈全世界熱帶地區的濱海", "特徵": "莖蔓生，具捲鬚，每節生根，根深入砂土，屬典型砂原植物，為防風定砂植物。葉尖端凹裂，形似馬鞍。花筒狀、紫色，花期夏秋季，但花朵壽命極短（約半天時間即凋落）。對濱海砂原環境適性特佳", "用途": "濱海砂地、礫灘、石堆，甚至防波堤綠化栽植", "生態": "濱海砂原固砂防風植物", "繁殖方法": "播種、扦插"}}, {"name": "松葉景天", "fields": {"科別/生活型": "景天科，多年生多肉草本植物", "原產地": "墨西哥、北美洲、台灣北部", "特徵": "莖呈匍匐狀，局部直立，莖節容易生根。葉圓柱狀、肉質；花序頂生，花金黃色，花期早春。莖含水量多，表皮特化成角質具有防水分散失構造，耐旱性極佳", "用途": "一般庭院栽植、盆栽，尤其適合屋頂綠化、綠牆栽種，以及濱海地被等", "繁殖方法": "扦插"}}, {"name": "崗姫竹", "fields": {"科別/生活型": "禾本科竹亞科，多年生常綠地被", "原產地": "中國大陸、日本", "特徵": "為小型的竹類植物，稈中空，直立有節，根狀（地下）莖橫走，地上莖自節抽生，株高約1M，植株矮小密集，可形成理想植被。散生型竹類，具棲地擴張性；適全日照至半遮蔭環境", "用途": "適坡地、庭院地被栽種", "繁殖方法": "分株（分叢）"}}, {"name": "馬蹄金", "fields": {"科別/生活型": "旋花科，多年生匍匐性草本地被", "原產地": "中國、台灣（原生種）", "特徵": "莖細長匍匐，每節皆能生根；葉圓或腎形，花小型、鐘狀黃色。種子黃至褐色。適全日照至半遮蔭環境", "用途": "一般庭院地被栽植"}}, {"name": "聖奧古斯丁草（鈍葉草）", "fields": {"科別/生活型": "禾本科，多年生禾草地被", "原產地": "美國、熱帶美洲、牙買加、波多黎各", "特徵": "根莖匍匐，根系吃土較深，常用於坡地水土保持栽植，葉片鈍型，又名「鈍葉草」。匍匐性強，生長速度緩慢，耐鹽性佳，亦可栽植於濱海砂質地形", "用途": "一般庭院草坪栽植，山坡地水土保持應用；另有斑葉園藝栽培種"}}, {"name": "腎蕨", "fields": {"科別/生活型": "腎蕨科", "原產地": "廣泛分布全球熱帶至亞熱帶林地下層環境。台灣全島自平地至海拔2000M之山野皆見分布", "特徵": "屬附生或地生型態皆可適應。莖分為直立莖、匍匐莖及塊莖。一回羽狀複葉；台灣原生有二種腎蕨屬成員，另有多種引入種或園藝種", "用途": "林下地被、附生栽植（坡地或山壁上附生、綠牆植栽）"}}, {"name": "卷柏", "fields": {"科別/生活型": "卷柏科", "原產地": "廣泛分布全球熱帶、亞熱帶至暖溫帶之林下、山壁、潮濕環境；台灣有多種原生種類，都極適合用於環境綠化栽植", "特徵": "卷柏為原始的蕨類植物，尚未演化真正的葉子，以孢子繁殖個體。種類繁多，大多生長於遮蔭或半遮蔭較為濕潤的環境，其中部分耐旱力極強，在長期乾旱後只要根系再度遇水後就又可舒展", "用途": "一般庭院地被栽植、盆栽，林下或遮蔭環境植生覆蓋", "繁殖方法": "孢子繁殖，分株、扦插"}}, {"name": "巴西鳶尾", "fields": {"科別/生活型": "鳶尾科，多年生草本", "原產地": "墨西哥至巴西等拉丁美洲一帶（外來種）", "特徵": "葉片光滑，呈劍型，扇形排列；花朵大形，紫白相混。地下莖匍匐多節，葉及花梗皆自節處抽出。花梗扁平似葉狀，頂端開花，花朵謝後會自花梗尖端萌發新芽體，可用以繁殖新株。喜半日照至遮蔭環境", "用途": "一般用於庭院牆角或林下地被栽植", "生態": "蜜源植物"}}, {"name": "花葉絡石（初雪葛）", "fields": {"科別/生活型": "夾竹桃科", "原產地": "中國、台灣；花葉（斑葉）品種係日本培育選拔栽培之園藝種，廣泛應用於環境景觀布置", "特徵": "莖木質匍匐（藤本），植株具乳汁，莖具氣生根，橫走或攀附，新葉呈紅、粉、白相雜，極具觀賞性", "用途": "一般庭院地被栽植、盆栽", "繁殖方法": "扦插"}}, {"name": "白花三葉草", "fields": {"科別/生活型": "豆科蝶形花亞科，匍匐性多年生草本", "原產地": "北美洲（外來種）", "特徵": "莖匍匐橫走，偶有呈斜上昇狀莖。葉三出複葉，表面常有白色的斑塊，光滑無毛；花白色蝶狀，多數排列為頭狀花序。根部能與固氮根瘤菌共生，具改善土質功效。喜日照良好、涼爽、排水佳的環境", "用途": "適一般庭院地被栽植，亦有用作水土保持或牧草栽種者", "生態": "蜜源、牧草"}}, {"name": "紅毛莧", "fields": {"科別/生活型": "大戟科，多年生常綠匍匐狀草本植物", "原產地": "中美洲、西印度群島", "特徵": "莖纖細、成株枝條呈半蔓性匍匐或懸垂生長。葉紙質、有細毛。穗狀花序自莖端葉腋伸出，花小形紅色，聚成毛線狀，花期長，幾乎全年開花（尤以夏天開花為盛）。喜高溫、潮濕、陽光充足的環境", "用途": "庭園景觀栽植（地被）", "繁殖方法": "扦插"}}]}, {"name": "水生、濕地植物", "items": [{"name": "台灣菱（菱角）", "fields": {"科別/生活型": "菱科，浮葉型水生植物", "原產地": "中國", "特徵": "根固著於底泥，莖細柔，葉巨幅囊，可隨水漂浮，葉菱狀三角形，葉尖有鋸齒，葉柄膨大內呈海綿質，具助浮力；花單生，自葉腋抽生，開花後閉果沉入水中，外覆硬殼，即為可食用之菱角。適水域環境生長", "用途": "一般水池、生態池布置栽培", "生態": "生態池復育栽種，菱角田與水雉棲息關係密切"}}, {"name": "荷花", "fields": {"科別/生活型": "蓮科，大型挺水水生植物，多年生宿根草本", "原產地": "中南半島、印度、中國、日本、菲律賓、澳洲", "特徵": "地下莖（藕）橫向生長，自節點抽出葉及花梗；葉挺水而出，表面具細絨毛，附著力弱，水液無法附著其上。花色繁多，花期5-7月，花謝後花托膨大成蓮蓬，內容多粒蓮子。適水域環境生長", "用途": "一般庭院景觀水池、生態池布置栽培", "繁殖方法": "播種or分莖繁殖"}}, {"name": "睡蓮", "fields": {"科別/生活型": "睡蓮科，浮葉型水生植物，多年生水生草本", "原產地": "廣泛分布於北半球；熱帶至溫帶地區皆有", "特徵": "地下莖肉質，短促成塊狀，直立或橫走地底泥沼，呈山葵狀，沉於底泥；花、葉浮出水面上生長；花日間開放，夜間閉合，可以連續開閉三至五日。適水域環境生長", "用途": "一般庭院景觀水池、生態池布置栽培"}}, {"name": "水金英", "fields": {"科別/生活型": "黃花藺科", "原產地": "南美洲巴西、委內瑞拉等熱帶地區（外來種）", "特徵": "多年生水生草本，莖匍匐生長，沉於底泥；花、葉自節處抽生，浮出水面上生長；花金黃色、三瓣；適水域環境生長", "用途": "一般庭院景觀水池、生態池布置栽培", "繁殖方法": "分株"}}, {"name": "茭白", "fields": {"科別/生活型": "禾本科，一年生水生（宿根）禾草", "原產地": "東亞、西亞及北美洲", "特徵": "地下莖叢出，具芽點，可分蘖新芽，地上莖直立，基部經共生菰黑穗菌刺激而生成筍狀莖（菌癭），可供食用。適水域環境生長", "用途": "一般庭院景觀水池、生態池布置栽培、經濟栽培採摘茭白筍；植株具淨化水質功能"}}, {"name": "香蒲（水蠟燭）", "fields": {"科別/生活型": "香蒲科，多年生水生宿根草本", "原產地": "中國大陸、日本、台灣", "特徵": "地下根莖匍匐泥中，白色、具鬚根；地上部由葉鞘及花柄包覆成假莖，圓柱形；葉狹長劍狀；花兩性，開於柄頂，上端為雄花、下端為雌花，花期在夏季。適水域環境生長", "用途": "一般庭院景觀水池、生態池布置栽培"}}, {"name": "海芋", "fields": {"科別/生活型": "天南星科，多年生球根花卉", "原產地": "南非（外來種）", "特徵": "地下塊莖膨大具貯藏功能，葉及花柄自節點抽生，包被成偽莖；佛焰苞頂生，花期冬、春兩季（但以3-5月為盛）。喜日照充足、溫暖至冷涼之潮濕環境，不耐熱也不耐寒，適水域環境生長", "用途": "一般庭院景觀水池栽培、經濟栽培做切花用途"}}, {"name": "台灣萍蓬草", "fields": {"科別/生活型": "睡蓮科，多年生浮葉性水生草本植物", "原產地": "台灣（特有種）", "特徵": "地下有厚實的黃色塊莖。葉柄及花梗自節點抽生，葉長橢圓或闊卵形，浮於水面，邊緣有缺刻深裂；花梗粗長、挺水，花冠杯形，花瓣退化，萼片黃色，中央花器成艷紅色。適水域環境生長", "用途": "一般庭院景觀水池、生態池復育栽培", "生態": "台灣特有種植物，全球萍蓬草屬自然分布的最南界種類"}}, {"name": "風箱樹", "fields": {"科別/生活型": "茜草科，落葉性灌木或小喬木", "原產地": "中國、印度、緬甸、北美、台灣（分布於北部、東北部平地溝渠）", "特徵": "頭狀花序腋生或頂生，具濃郁香味；花期夏季。喜水域或多濕環境", "用途": "可栽植於一般庭院景觀水池或生態池，早期先民種植於水岸或圳岸作為防止沖蝕的護岸天然材料", "生態": "功能極強的蜜源植物", "繁殖方法": "扦插"}}, {"name": "斑葉蘆葦", "fields": {"科別/生活型": "禾本科，多年生宿根禾草，為蘆葦的斑葉變種", "原產地": "全球亞熱帶至溫帶地區", "特徵": "地下莖叢出，根部粗而多結，有節具芽點，可分蘖新芽，地上莖（桿）直立；葉互生，具白色條紋；穗狀花序頂生，形似掃帚。適水域環境生長", "用途": "一般庭院景觀水池、生態池布置栽培", "繁殖方法": "扦插、分株"}}, {"name": "薏苡", "fields": {"科別/生活型": "禾本科，多年生宿根性草本", "原產地": "越南、泰國、印度及緬甸等東南亞一帶", "特徵": "莖桿單一直立，基部可分蘗成叢。花序直立或下垂，腋生，穎果成熟時，總苞（外殼）堅硬光滑，內覆種仁即為常食用之薏米。適應力佳，喜日照良好之水域濕地、潤土，但旱地生長適應亦可", "用途": "適一般庭院濕地環境栽植", "繁殖方法": "播種、扦插"}}, {"name": "水生鳶尾", "fields": {"科別/生活型": "鳶尾科，多年生宿根性草本植物", "原產地": "泛指鳶尾屬水生花卉，非單一種類，亦有多種雜交種及園藝栽培種", "特徵": "具肉質狀球莖構造，葉及花柄自基部節點密集抽生；花頂生，花色繁多，有紫、紅、粉、黃、藍、白等，花形大，極具觀賞機能，花期春至夏季。喜日照良好之水域環境", "用途": "適一般庭院景觀水池栽植", "繁殖方法": "利用根莖繁殖"}}]}, {"name": "蔓藤植物", "items": [{"name": "紫藤", "fields": {"科別/生活型": "豆科蝶形花亞科，落葉木質藤蔓", "原產地": "中國大陸", "特徵": "木質化莖具纏繞性，可攀援其他植株或設施向上攀生；葉為一回羽狀複葉，冬季低溫期會落葉；花穗（總狀花序）大而懸垂，花色紫或淡紫，果實為莢果。喜日照良好環境", "用途": "適一般庭院景觀栽植，生長迅速，需攀爬架", "繁殖方法": "常用扦插、壓條、嫁接或播種"}}, {"name": "多花素馨", "fields": {"科別/生活型": "木犀科，常綠木質藤蔓", "原產地": "中國大陸、越南、印度（外來種）", "特徵": "木質化莖具纏繞性，葉互生一回羽狀；花穗懸垂，色白，具濃郁芳香。喜涼爽、日照良好環境", "用途": "適一般庭院景觀栽植，需攀爬架", "繁殖方法": "扦插或壓條"}}, {"name": "越橘葉蔓榕", "fields": {"科別/生活型": "桑科", "原產地": "中國大陸、臺灣", "特徵": "多年生常綠木質蔓性，莖匍匐生長，每節都容易長出不定根，但不具攀爬特性；葉小型，隱頭花序（果），生性強健。環境耐受能力佳，喜日照良好的環境", "用途": "適一般庭院地被栽植", "繁殖方法": "扦插"}}, {"name": "金盃藤", "fields": {"科別/生活型": "茄科，常綠木質蔓藤", "原產地": "中美洲（外來種）", "特徵": "莖柔弱，依附攀爬；葉大型、長橢圓形；單頂花序，花大型筒狀、黃色間雜紅褐色線條，具清淡香氣。喜涼爽、日照充足環境。植株具毒性", "用途": "適一般庭院棚架栽植", "繁殖方法": "扦插或高壓法"}}, {"name": "木玫瑰", "fields": {"科別/生活型": "旋花科，多年生常綠蔓藤", "原產地": "熱帶美洲（外來種）", "特徵": "莖草質纏繞攀爬；葉掌狀開裂；花大、筒狀、色黃；蒴果成熟後萼片不規則開裂呈木質化，狀似乾燥的玫瑰花。喜溫暖、日照充足環境", "用途": "適一般庭院棚架栽植", "繁殖方法": "播種或莖條扦插"}}, {"name": "蔦蘿", "fields": {"科別/生活型": "旋花科，一年生草本蔓藤", "原產地": "墨西哥、熱帶美洲（外來種）", "特徵": "莖草質纏繞攀爬；葉羽狀絲裂，花小型、長筒狀、色紅or白，蒴果成熟乾裂後內容數枚種子。花期夏至秋", "用途": "喜溫暖、日照充足環境，適一般庭院棚架栽植", "繁殖方法": "實生法"}}, {"name": "軟枝黃蟬", "fields": {"科別/生活型": "夾竹桃科，常綠木本蔓藤", "原產地": "巴西、熱帶美洲（外來種）", "特徵": "莖木質依附攀援；葉3-4枚輪生；莖葉皆富含乳汁，花大型、筒狀、金黃色。全株有毒。喜溫暖、日照充足環境", "用途": "適一般庭院棚架、牆垣栽植", "繁殖方法": "扦插、壓條"}}, {"name": "常春藤", "fields": {"科別/生活型": "五加科，多年生草本蔓藤", "原產地": "歐洲、亞洲和北非（台灣有野生自然分布品種）", "特徵": "莖草質，莖節間易生氣根，具吸附性，可攀爬，葉掌狀或掌裂，多數園藝應用種具斑紋。喜涼爽、半日照或局部遮蔭環境", "用途": "適一般庭院栽植、懸垂吊盆", "繁殖方法": "扦插"}}, {"name": "黃金葛", "fields": {"科別/生活型": "天南星科，多年生草本蔓藤", "原產地": "廣泛分布於熱帶及亞熱帶地區林下、樹幹或潮濕岩壁", "特徵": "莖草質，莖節間易生氣根，具吸附性，可攀爬；葉盾狀，葉脈間常間雜白色斑紋，向上攀爬時葉子面積會越長越大，並產生窗孔構造，反之向下懸垂則葉子漸小。喜暖濕、半日照或局部遮蔭環境", "用途": "適一般庭院林下栽植、懸垂吊盆或立柱栽植", "繁殖方法": "扦插"}}, {"name": "懸星花", "fields": {"科別/生活型": "茄科，多年生草本蔓藤", "原產地": "巴西、熱帶美洲、佛羅里達南部", "特徵": "多年生蔓藤，莖草質，具半纏繞、半依附性，能攀援，葉羽狀開裂；圓錐狀花序頂生下垂，具數朵小花、色淡紫；果實成熟由綠轉紅，掛樹時間久，具觀賞性。喜暖濕、日照充足之環境。植株具毒性", "用途": "適一般庭院棚架栽植", "繁殖方法": "實生法"}}, {"name": "三星果藤", "fields": {"科別/生活型": "黃褥花科，常綠木本蔓藤", "原產地": "菲、馬、太平洋諸島。台灣自然分布於恆春、蘭嶼海邊", "特徵": "莖木質，具半纏繞、半依附性，能攀爬，單葉對生、表面光滑，花序頂生，小花五瓣、黃色；翅果呈星芒狀，三枚相互背靠。花期春至夏季。喜暖濕、日照充足之環境", "用途": "適一般庭院棚架栽植", "繁殖方法": "扦插"}}, {"name": "爬森藤", "fields": {"科別/生活型": "夾竹桃科，多年生草本蔓藤", "原產地": "華南、熱帶亞洲、台灣（自然分布於恆春半島與北海岸）", "特徵": "莖草質，具纏繞攀爬性，單葉對生；花序頂生，花小型；蓇葖長橢圓形，種子有翅毛，能隨風播散。喜暖濕、日照充足之環境。全株有毒", "用途": "一般庭院棚架、牆垣栽植", "生態": "蜜源、葉為大白斑蝶幼蟲食草", "繁殖方法": "播種、扦插"}}]}]}}</script>
<script>
(function(){
  "use strict";
  var DATA = JSON.parse(document.getElementById('app-data').textContent);
  var state = {
    mode: 'plants',          // materials | plants | quiz
    plantCat: DATA.plants.subcats[0].name,
    materialCat: DATA.materials.subcats[0].name,
    search: '',
    quiz: { phase:'settings', catSel:null, total:10, idx:0, score:0, questions:[], answered:false, review:[] }
  };

  var root = document.getElementById('root');
  var tabsEl = document.getElementById('tabs');

  function esc(s){
    return String(s==null?'':s).replace(/[&<>"']/g, function(c){
      return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];
    });
  }
  function shuffle(arr){
    var a = arr.slice();
    for (var i=a.length-1;i>0;i--){ var j=Math.floor(Math.random()*(i+1)); var t=a[i]; a[i]=a[j]; a[j]=t; }
    return a;
  }
  function sample(arr,n){ return shuffle(arr).slice(0,n); }
  function pick(arr){ return arr[Math.floor(Math.random()*arr.length)]; }

  /* ---------------- flatten pools ---------------- */
  var plantPool = [];
  DATA.plants.subcats.forEach(function(sub){
    sub.items.forEach(function(it){ plantPool.push({name:it.name, cat:sub.name, fields:it.fields}); });
  });
  var materialPool = [];
  DATA.materials.subcats.forEach(function(sub){
    sub.items.forEach(function(it){ materialPool.push({name:it.name, cat:sub.name, desc:it.desc}); });
  });
  var plantCatNames = DATA.plants.subcats.map(function(s){return s.name;});
  var materialCatNames = DATA.materials.subcats.map(function(s){return s.name;});

  /* quiz scope categories: the 8 plant categories kept separate, all materials combined into one */
  var QUIZ_CATS = plantCatNames.map(function(name){
    return {id:'p:'+name, type:'plant', match:name, label:name+'類', count: plantPool.filter(function(p){return p.cat===name;}).length};
  }).concat([
    {id:'m:all', type:'material', match:null, label:'其他栽培介質及資材類', count: materialPool.length}
  ]);
  state.quiz.catSel = {};
  QUIZ_CATS.forEach(function(c){ state.quiz.catSel[c.id] = true; });

  /* ================= RENDER: TABS ================= */
  function renderTabs(){
    var tabs = [
      {id:'plants', label:'識別參考植物', count:plantPool.length},
      {id:'materials', label:'識別資材', count:materialPool.length},
      {id:'quiz', label:'隨機測驗', count:null}
    ];
    tabsEl.innerHTML = tabs.map(function(t){
      return '<button class="tab" data-mode="'+t.id+'" data-active="'+(state.mode===t.id)+'" onclick="APP.setMode(\''+t.id+'\')">'+
        esc(t.label) + (t.count!=null ? ' <span class="count">'+t.count+'</span>' : '') +
      '</button>';
    }).join('');
  }

  /* ================= RENDER: BROWSE ================= */
  function renderBrowse(kind){
    var isP = kind==='plants';
    var pool = isP ? DATA.plants.subcats : DATA.materials.subcats;
    var activeCat = isP ? state.plantCat : state.materialCat;
    var activeSub = pool.filter(function(s){return s.name===activeCat;})[0] || pool[0];
    var q = state.search.trim().toLowerCase();

    var items = activeSub.items;
    if (q){
      items = activeSub.items.filter(function(it){
        var hay = it.name.toLowerCase();
        if (isP){ hay += ' ' + Object.values(it.fields).join(' ').toLowerCase(); }
        else { hay += ' ' + it.desc.join(' ').toLowerCase(); }
        return hay.indexOf(q) !== -1;
      });
    }

    var rail = pool.map(function(s){
      return '<li><button class="rail-btn" data-active="'+(s.name===activeSub.name)+'" onclick="APP.setCat(\''+kind+'\',\''+esc(s.name).replace(/'/g,"\\'")+'\')">'+
        '<span>'+esc(s.name)+'</span><span class="n">'+s.items.length+'</span></button></li>';
    }).join('');

    var cards = items.map(function(it, i){
      var teaser = isP ? (it.fields['特徵'] || it.fields['科別/生活型'] || it.fields['原產地'] || '') : (it.desc[0]||'');
      var chip = isP ? activeSub.name : activeSub.name;
      var origIdx = activeSub.items.indexOf(it);
      return '<button class="item-card" onclick="APP.openDetail(\''+kind+'\',\''+esc(activeSub.name).replace(/'/g,"\\'")+'\','+origIdx+')">'+
        '<span class="chip">'+esc(chip)+'</span>'+
        '<span class="name">'+esc(it.name)+'</span>'+
        '<span class="teaser">'+esc(teaser)+'</span>'+
      '</button>';
    }).join('');

    return (
      '<div class="browse" data-mode="'+kind+'">' +
        '<div class="rail">' +
          '<div class="rail-title">分類</div>' +
          '<ul class="rail-list">'+rail+'</ul>' +
        '</div>' +
        '<div>' +
          '<div class="panel-head">' +
            '<h2>'+esc(activeSub.name)+' <span style="color:var(--text-muted);font-weight:400;font-size:14px;">（'+activeSub.items.length+' 項）</span></h2>' +
            '<label class="search"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>' +
            '<input placeholder="搜尋名稱或內容…" value="'+esc(state.search)+'" oninput="APP.setSearch(this.value)"/></label>' +
          '</div>' +
          (items.length ? '<div class="grid">'+cards+'</div>' : '<div class="empty-note">沒有符合「'+esc(state.search)+'」的項目。</div>') +
        '</div>' +
      '</div>'
    );
  }

  /* ================= DETAIL MODAL ================= */
  var PLANT_FIELD_ORDER = ['科別/生活型','原產地','特徵','用途','生態','繁殖方法','相近種類','別名','花期','備註'];

  function openDetail(kind, subName, idx){
    var isP = kind==='plants';
    var subs = isP ? DATA.plants.subcats : DATA.materials.subcats;
    var sub = subs.filter(function(s){return s.name===subName;})[0];
    var it = sub.items[idx];
    var body;
    if (isP){
      body = PLANT_FIELD_ORDER.filter(function(k){return it.fields[k];}).map(function(k){
        return '<div class="field-row"><div class="label">'+esc(k)+'</div><div class="value">'+esc(it.fields[k])+'</div></div>';
      }).join('');
    } else {
      body = '<ul>'+it.desc.map(function(d){return '<li>'+esc(d)+'</li>';}).join('')+'</ul>';
    }
    var html =
      '<div class="backdrop" onclick="if(event.target===this)APP.closeDetail()" data-mode="'+kind+'">' +
        '<div class="modal" role="dialog" aria-modal="true">' +
          '<div class="modal-head">' +
            '<div><span class="chip">'+esc(subName)+'</span><h3>'+esc(it.name)+'</h3></div>' +
            '<button class="modal-close" onclick="APP.closeDetail()" aria-label="關閉">✕</button>' +
          '</div>' +
          '<div class="modal-body">'+body+'</div>' +
        '</div>' +
      '</div>';
    var host = document.createElement('div');
    host.id = 'modal-host';
    host.innerHTML = html;
    document.body.appendChild(host);
    document.addEventListener('keydown', escHandler);
  }
  function escHandler(e){ if(e.key==='Escape') closeDetail(); }
  function closeDetail(){
    var host = document.getElementById('modal-host');
    if (host) host.remove();
    document.removeEventListener('keydown', escHandler);
  }

  /* ================= QUIZ GENERATION ================= */
  function trimText(s, n){
    s = String(s);
    return s.length>n ? s.slice(0,n-1)+'…' : s;
  }

  var PLANT_Q_FIELDS = [
    {key:'科別/生活型', label:'科別／生活型'},
    {key:'原產地', label:'原產地'},
    {key:'用途', label:'用途'},
    {key:'繁殖方法', label:'繁殖方法'}
  ];

  function buildMCQ(promptHtml, correctText, distractorTexts, tag){
    var opts = shuffle([{t:correctText, ok:true}].concat(distractorTexts.map(function(t){return {t:t, ok:false};})));
    return {tag:tag, prompt:promptHtml, options:opts.map(function(o){return o.t;}), correctIndex: opts.findIndex(function(o){return o.ok;})};
  }

  /* Each try* function returns a question object, or null if not applicable — never calls another try* function,
     so the chain in genPlantQuestion/genMaterialQuestion always terminates. */
  function tryPlantFieldQ(item, pool){
    var candidates = PLANT_Q_FIELDS.filter(function(f){ return item.fields[f.key]; });
    if (!candidates.length) return null;
    var f = pick(candidates);
    var correct = item.fields[f.key];
    var others = pool.filter(function(p){ return p.name!==item.name && p.fields[f.key] && p.fields[f.key]!==correct; });
    if (others.length < 3) return null;
    var distractors = sample(others,3).map(function(p){ return trimText(p.fields[f.key], 60); });
    return buildMCQ('「'+esc(item.name)+'」的<b>'+esc(f.label)+'</b>為何？', trimText(correct,60), distractors, 'plant');
  }
  function tryPlantClueQ(item, pool){
    var clueField = item.fields['特徵'] ? '特徵' : (item.fields['生態'] ? '生態' : null);
    if (!clueField) return null;
    var others = pool.filter(function(p){ return p.name!==item.name; });
    if (others.length<3) return null;
    var distractors = sample(others,3).map(function(p){return p.name;});
    return buildMCQ('下列敘述描述的是哪一種植物？<br><span style="font-weight:400;color:var(--text-muted);display:block;margin-top:8px;font-size:14.5px;">「'+esc(trimText(item.fields[clueField],110))+'」</span>', item.name, distractors, 'plant');
  }
  function tryPlantCatQ(item, activeCatNames){
    // only meaningful when 2+ plant categories are in scope (otherwise every correct answer is identical)
    if (activeCatNames.length < 2) return null;
    var others = activeCatNames.filter(function(c){return c!==item.cat;});
    var distractors = sample(others, Math.min(3, others.length));
    return buildMCQ('「'+esc(item.name)+'」屬於下列哪一個分類？', item.cat, distractors, 'plant');
  }
  function plantCatQAnyScope(item){
    // guaranteed-safe fallback: ignores the active-scope restriction, uses the full category list
    var others = plantCatNames.filter(function(c){return c!==item.cat;});
    var distractors = sample(others,3);
    return buildMCQ('「'+esc(item.name)+'」屬於下列哪一個分類？', item.cat, distractors, 'plant');
  }
  function genPlantQuestion(item, pool, activeCatNames){
    var order = shuffle(['field','clue','cat']);
    for (var i=0;i<order.length;i++){
      var q = order[i]==='field' ? tryPlantFieldQ(item, pool) :
              order[i]==='clue'  ? tryPlantClueQ(item, pool) :
                                    tryPlantCatQ(item, activeCatNames);
      if (q) return q;
    }
    return plantCatQAnyScope(item);
  }

  function tryMaterialCatQ(item){
    var others = materialCatNames.filter(function(c){return c!==item.cat;});
    var distractors = sample(others,3);
    return buildMCQ('「'+esc(item.name)+'」屬於下列哪一個資材類別？', item.cat, distractors, 'material');
  }
  function tryMaterialClueQ(item, pool){
    if (!item.desc.length) return null;
    var clue = pick(item.desc);
    var others = pool.filter(function(p){ return p.name!==item.name; });
    if (others.length<3) return null;
    var distractors = sample(others,3).map(function(p){return p.name;});
    return buildMCQ('下列敘述描述的是哪一項資材？<br><span style="font-weight:400;color:var(--text-muted);display:block;margin-top:8px;font-size:14.5px;">「'+esc(trimText(clue,110))+'」</span>', item.name, distractors, 'material');
  }
  function genMaterialQuestion(item, pool){
    var order = shuffle(['clue','cat']);
    for (var i=0;i<order.length;i++){
      var q = order[i]==='clue' ? tryMaterialClueQ(item, pool) : tryMaterialCatQ(item);
      if (q) return q;
    }
    return tryMaterialCatQ(item); // materialCatNames always has >=3 alternatives, so this never returns null
  }

  function genOneQuestion(pools){
    var usePlant;
    if (!pools.materials.length) usePlant = true;
    else if (!pools.plants.length) usePlant = false;
    else usePlant = Math.random() < pools.plants.length/(pools.plants.length+pools.materials.length);

    if (usePlant){
      return genPlantQuestion(pick(pools.plants), pools.plants, pools.activeCatNames);
    } else {
      return genMaterialQuestion(pick(pools.materials), pools.materials);
    }
  }

  function computeQuizPools(catSel){
    var activeCatNames = QUIZ_CATS.filter(function(c){return c.type==='plant' && catSel[c.id];}).map(function(c){return c.match;});
    var pPool = plantPool.filter(function(p){ return activeCatNames.indexOf(p.cat)!==-1; });
    var mPool = catSel['m:all'] ? materialPool : [];
    return {plants:pPool, materials:mPool, activeCatNames:activeCatNames};
  }

  function buildQuiz(catSel, total){
    var pools = computeQuizPools(catSel);
    if (pools.plants.length + pools.materials.length < 4) return [];
    var qs = [], seen = {}, guardCount = 0;
    while (qs.length < total && guardCount < total*30){
      guardCount++;
      var q = genOneQuestion(pools);
      var key = q.tag+'|'+q.prompt+'|'+q.correctIndex+'|'+q.options.join(',');
      if (seen[key]) continue;
      seen[key] = true;
      qs.push(q);
    }
    return qs;
  }

  /* ================= RENDER: QUIZ ================= */
  function renderQuiz(){
    var qz = state.quiz;
    if (qz.phase==='settings') return renderQuizSettings();
    if (qz.phase==='running') return renderQuizRunning();
    return renderQuizSummary();
  }

  function renderQuizSettings(){
    var qz = state.quiz;
    var counts = [10,20,30,50];
    var pools = computeQuizPools(qz.catSel);
    var total = pools.plants.length + pools.materials.length;
    var selectedCount = QUIZ_CATS.filter(function(c){return qz.catSel[c.id];}).length;
    var allOn = selectedCount === QUIZ_CATS.length;

    var catChips = QUIZ_CATS.map(function(c){
      var on = !!qz.catSel[c.id];
      return '<button class="checkchip" data-active="'+on+'" onclick="APP.toggleQuizCat(\''+c.id+'\')">' +
        '<span class="box">'+(on?'✓':'')+'</span><span>'+esc(c.label)+'</span><span class="n">'+c.count+'</span>' +
      '</button>';
    }).join('');

    var canStart = total >= 4;

    return (
      '<div class="quiz-wrap">' +
        '<div class="quiz-card">' +
          '<h2 style="margin-top:0;">開始隨機測驗</h2>' +
          '<p style="color:var(--text-muted);font-size:14px;margin-top:-6px;">從講義內容隨機出選擇題，適合檢定前自我複習。</p>' +
          '<div class="quiz-setting-row">' +
            '<div class="label" style="display:flex;justify-content:space-between;align-items:center;">' +
              '<span>測驗類別（可複選，'+selectedCount+' / '+QUIZ_CATS.length+' 類已選）</span>' +
              '<button class="btn-ghost" style="padding:4px 12px;font-size:12.5px;" onclick="APP.toggleAllQuizCats('+(!allOn)+')">'+(allOn?'全部取消':'全選')+'</button>' +
            '</div>' +
            '<div class="checkgrid">'+catChips+'</div>' +
          '</div>' +
          '<div class="quiz-setting-row"><div class="label">題數</div><div class="pillset">' +
            counts.map(function(c){return '<button class="pill" data-active="'+(qz.total===c)+'" onclick="APP.setQuizTotal('+c+')">'+c+' 題</button>';}).join('') +
          '</div></div>' +
          (canStart
            ? '<p style="color:var(--text-muted);font-size:13px;margin:-6px 0 16px;">目前所選類別共 '+total+' 項可供出題。</p>'
            : '<p style="color:var(--bad);font-size:13px;margin:-6px 0 16px;">請至少選擇一個類別（且項目總數需滿 4 項）才能開始測驗。</p>') +
          '<button class="btn-primary" '+(canStart?'':'disabled style="opacity:.5;cursor:not-allowed;"')+' onclick="APP.startQuiz()">開始測驗</button>' +
        '</div>' +
      '</div>'
    );
  }

  function renderQuizRunning(){
    var qz = state.quiz;
    var q = qz.questions[qz.idx];
    var pct = Math.round((qz.idx)/qz.questions.length*100);
    var optsHtml = q.options.map(function(opt, i){
      var state_ = 'idle';
      if (qz.answered){
        if (i===q.correctIndex) state_ = 'correct';
        else if (i===qz.chosen) state_ = 'wrong';
      }
      return '<button class="opt" data-state="'+state_+'" '+(qz.answered?'disabled':'')+' onclick="APP.answerQuiz('+i+')">'+
        '<span class="k">'+String.fromCharCode(65+i)+'</span><span>'+esc(opt)+'</span>' +
      '</button>';
    }).join('');

    var feedback = '';
    if (qz.answered){
      var ok = qz.chosen===q.correctIndex;
      feedback = '<div class="feedback '+(ok?'correct':'wrong')+'">'+(ok?'✓ 答對了':'✕ 答錯了，正確答案是「'+esc(q.options[q.correctIndex])+'」')+'</div>';
    }

    return (
      '<div class="quiz-wrap">' +
        '<div class="quiz-card">' +
          '<div class="qz-top"><span class="qz-progress">第 '+(qz.idx+1)+' / '+qz.questions.length+' 題</span><span class="qz-score">得分 '+qz.score+' / '+(qz.idx+(qz.answered?1:0))+'</span></div>' +
          '<div class="progress-bar"><div style="width:'+pct+'%"></div></div>' +
          '<span class="qz-tag '+q.tag+'">'+(q.tag==='plant'?'識別參考植物':'識別資材')+'</span>' +
          '<p class="qz-question">'+q.prompt+'</p>' +
          '<div class="options">'+optsHtml+'</div>' +
          feedback +
          '<div class="qz-actions">' +
            (qz.answered ? '<button class="btn-primary" style="width:auto;" onclick="APP.nextQuiz()">'+(qz.idx+1<qz.questions.length?'下一題 →':'查看結果 →')+'</button>' : '') +
          '</div>' +
        '</div>' +
      '</div>'
    );
  }

  function renderQuizSummary(){
    var qz = state.quiz;
    var pct = Math.round(qz.score/qz.questions.length*100);
    var msg = pct>=90 ? '非常熟練，保持下去！' : pct>=70 ? '掌握得不錯，再加強弱項即可。' : '建議再回去分類頁面複習相關項目。';
    var reviewHtml = qz.review.length ? qz.review.map(function(r){
      return '<div class="review-item"><div class="q">'+r.prompt.replace(/<br>.*$/,'')+'</div>' +
        '<div><span class="a wrong-was">'+esc(r.chosenText)+'</span><span class="a">→ '+esc(r.correctText)+'</span></div></div>';
    }).join('') : '<div style="color:var(--text-muted);font-size:13.5px;">全部答對，沒有需要複習的題目！</div>';

    return (
      '<div class="quiz-wrap">' +
        '<div class="quiz-card">' +
          '<h2 style="margin-top:0;">測驗結果</h2>' +
          '<div class="summary-score"><span class="big mono">'+qz.score+'</span><span class="of">/ '+qz.questions.length+' 題　（'+pct+'%）</span></div>' +
          '<div class="summary-msg">'+msg+'</div>' +
          (qz.review.length ? '<div class="quiz-setting-row"><div class="label">答錯題目回顧</div></div>' : '') +
          '<div class="review-list">'+reviewHtml+'</div>' +
          '<button class="btn-ghost" onclick="APP.resetQuiz()">重新設定測驗</button>' +
        '</div>' +
      '</div>'
    );
  }

  /* ================= MAIN RENDER ================= */
  function render(){
    renderTabs();
    if (state.mode==='quiz') root.innerHTML = renderQuiz();
    else root.innerHTML = renderBrowse(state.mode);
  }

  /* ================= PUBLIC API ================= */
  window.APP = {
    setMode: function(m){ state.mode=m; state.search=''; render(); window.scrollTo({top:0}); },
    setCat: function(kind,name){ if(kind==='plants') state.plantCat=name; else state.materialCat=name; state.search=''; render(); },
    setSearch: function(v){ state.search=v; render(); var el=document.querySelector('.search input'); if(el){el.focus(); el.selectionStart=el.selectionEnd=el.value.length;} },
    openDetail: openDetail,
    closeDetail: closeDetail,
    toggleQuizCat: function(id){ var qz=state.quiz; qz.catSel[id] = !qz.catSel[id]; render(); },
    toggleAllQuizCats: function(on){ var qz=state.quiz; QUIZ_CATS.forEach(function(c){ qz.catSel[c.id]=on; }); render(); },
    setQuizTotal: function(n){ state.quiz.total=n; render(); },
    startQuiz: function(){
      var qz = state.quiz;
      var qs = buildQuiz(qz.catSel, qz.total);
      if (!qs.length) { render(); return; }
      qz.questions = qs;
      qz.idx = 0; qz.score = 0; qz.answered = false; qz.chosen = null; qz.review = [];
      qz.phase = 'running';
      render();
    },
    answerQuiz: function(i){
      var qz = state.quiz;
      if (qz.answered) return;
      qz.answered = true; qz.chosen = i;
      var q = qz.questions[qz.idx];
      if (i===q.correctIndex){ qz.score++; }
      else { qz.review.push({prompt:q.prompt, chosenText:q.options[i], correctText:q.options[q.correctIndex]}); }
      render();
    },
    nextQuiz: function(){
      var qz = state.quiz;
      if (qz.idx+1 < qz.questions.length){
        qz.idx++; qz.answered=false; qz.chosen=null; render();
      } else {
        qz.phase='summary'; render();
      }
    },
    resetQuiz: function(){ state.quiz.phase='settings'; render(); }
  };

  render();
})();
</script>
