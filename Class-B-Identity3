<title>造園識別圖鑑</title>
<meta name="description" content="造園景觀乙級技能檢定識別資材與參考植物線上圖鑑，含分類查閱與隨機測驗">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@500;600;700&family=Noto+Sans+TC:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap">
<style>
  :root{
    --bg:#F4F7F1;
    --surface:#FFFFFF;
    --surface-2:#EAEFE5;
    --text:#1B271C;
    --text-muted:#59695C;
    --border:#D9E1D2;
    --accent-plant:#2F5233;
    --accent-plant-soft:#E2ECDD;
    --accent-material:#93601F;
    --accent-material-soft:#F1E6D2;
    --accent-quiz:#2A6B78;
    --accent-quiz-soft:#DDEBEC;
    --good:#2E7D45;
    --good-soft:#E1F0E2;
    --bad:#B33B3B;
    --bad-soft:#F7E4E1;
    --shadow: 0 1px 2px rgba(27,39,28,.06), 0 6px 20px rgba(27,39,28,.06);
    --radius: 14px;
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]){
      --bg:#12160F;
      --surface:#1A2018;
      --surface-2:#212820;
      --text:#E7EEE3;
      --text-muted:#9FB19B;
      --border:#2E3A2A;
      --accent-plant:#79C48B;
      --accent-plant-soft:#1E3223;
      --accent-material:#DDA75C;
      --accent-material-soft:#3A2C15;
      --accent-quiz:#7ACBDB;
      --accent-quiz-soft:#173238;
      --good:#79C48B;
      --good-soft:#1C3220;
      --bad:#E58686;
      --bad-soft:#3A2020;
      --shadow: 0 1px 2px rgba(0,0,0,.3), 0 8px 24px rgba(0,0,0,.35);
      color-scheme: dark;
    }
  }
  :root[data-theme="dark"]{
    --bg:#12160F;
    --surface:#1A2018;
    --surface-2:#212820;
    --text:#E7EEE3;
    --text-muted:#9FB19B;
    --border:#2E3A2A;
    --accent-plant:#79C48B;
    --accent-plant-soft:#1E3223;
    --accent-material:#DDA75C;
    --accent-material-soft:#3A2C15;
    --accent-quiz:#7ACBDB;
    --accent-quiz-soft:#173238;
    --good:#79C48B;
    --good-soft:#1C3220;
    --bad:#E58686;
    --bad-soft:#3A2020;
    --shadow: 0 1px 2px rgba(0,0,0,.3), 0 8px 24px rgba(0,0,0,.35);
    color-scheme: dark;
  }

  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:var(--bg);
    color:var(--text);
    font-family:'Noto Sans TC','PingFang TC','Microsoft JhengHei',sans-serif;
    line-height:1.6;
    -webkit-font-smoothing:antialiased;
  }
  h1,h2,h3,.serif{font-family:'Noto Serif TC','Noto Sans TC',serif;}
  .mono{font-family:'IBM Plex Mono',ui-monospace,monospace; font-variant-numeric: tabular-nums;}
  a{color:inherit;}
  button{font:inherit;color:inherit;}
  ::selection{background:var(--accent-plant-soft);}

  .app{max-width:1180px;margin:0 auto;padding:0 20px 64px;}

  /* ---------- Top bar ---------- */
  .topbar{
    position:sticky; top:0; z-index:30;
    background:var(--bg);
    border-bottom:1px solid var(--border);
    padding:18px 20px 0;
  }
  .topbar-inner{max-width:1180px;margin:0 auto;}
  .brand{display:flex; align-items:baseline; gap:10px; flex-wrap:wrap; margin-bottom:14px;}
  .brand-mark{
    display:inline-flex; align-items:center; justify-content:center;
    width:34px; height:34px; border-radius:9px;
    background:var(--accent-plant); color:var(--surface);
    font-family:'Noto Serif TC',serif; font-weight:700; font-size:16px;
    flex:none;
  }
  .brand h1{font-size:21px; font-weight:700; margin:0; letter-spacing:.01em;}
  .brand .sub{font-size:12.5px; color:var(--text-muted); font-family:'IBM Plex Mono',monospace;}

  .tabs{display:flex; gap:4px; overflow-x:auto;}
  .tab{
    appearance:none; border:none; background:none; cursor:pointer;
    padding:10px 16px 12px; font-size:14.5px; font-weight:600;
    color:var(--text-muted); border-bottom:2.5px solid transparent;
    white-space:nowrap;
    display:flex; align-items:center; gap:7px;
  }
  .tab .count{font-family:'IBM Plex Mono',monospace; font-size:11.5px; font-weight:500;
    background:var(--surface-2); padding:1px 7px; border-radius:20px; color:var(--text-muted);}
  .tab[data-active="true"]{color:var(--text);}
  .tab[data-mode="materials"][data-active="true"]{border-color:var(--accent-material); color:var(--accent-material);}
  .tab[data-mode="plants"][data-active="true"]{border-color:var(--accent-plant); color:var(--accent-plant);}
  .tab[data-mode="quiz"][data-active="true"]{border-color:var(--accent-quiz); color:var(--accent-quiz);}
  .tab[data-mode="materials"][data-active="true"] .count{background:var(--accent-material-soft); color:var(--accent-material);}
  .tab[data-mode="plants"][data-active="true"] .count{background:var(--accent-plant-soft); color:var(--accent-plant);}
  .tab[data-mode="quiz"][data-active="true"] .count{background:var(--accent-quiz-soft); color:var(--accent-quiz);}

  /* ---------- Browse layout ---------- */
  .browse{display:grid; grid-template-columns:230px 1fr; gap:26px; margin-top:24px; align-items:start;}
  @media (max-width:820px){ .browse{grid-template-columns:1fr;} }

  .rail{position:sticky; top:96px;}
  @media (max-width:820px){ .rail{position:static;} }
  .rail-title{font-size:12px; text-transform:uppercase; letter-spacing:.08em; color:var(--text-muted); margin:0 0 10px 2px; font-family:'IBM Plex Mono',monospace;}
  .rail-list{display:flex; flex-direction:column; gap:2px; list-style:none; margin:0; padding:0;}
  .rail-btn{
    display:flex; justify-content:space-between; align-items:center; gap:8px;
    width:100%; text-align:left; padding:9px 12px; border-radius:9px; border:1px solid transparent;
    background:none; cursor:pointer; font-size:14px; color:var(--text);
  }
  .rail-btn:hover{background:var(--surface-2);}
  .rail-btn[data-active="true"]{background:var(--surface); border-color:var(--border); box-shadow:var(--shadow); font-weight:600;}
  .rail-btn .n{font-family:'IBM Plex Mono',monospace; font-size:11px; color:var(--text-muted);}

  .panel-head{display:flex; align-items:center; justify-content:space-between; gap:16px; flex-wrap:wrap; margin-bottom:16px;}
  .panel-head h2{font-size:19px; margin:0;}
  .search{
    display:flex; align-items:center; gap:8px;
    background:var(--surface); border:1px solid var(--border); border-radius:10px;
    padding:8px 12px; min-width:220px; flex:1; max-width:320px;
  }
  .search input{border:none; outline:none; background:none; color:var(--text); font-size:14px; width:100%;}
  .search svg{flex:none; opacity:.55;}

  .grid{display:grid; grid-template-columns:repeat(auto-fill,minmax(150px,1fr)); gap:10px;}
  .item-card{
    text-align:left; cursor:pointer; background:var(--surface); border:1px solid var(--border);
    border-radius:11px; padding:12px 13px 13px; display:flex; flex-direction:column; gap:5px;
    transition:transform .12s ease, box-shadow .12s ease, border-color .12s ease;
  }
  .item-card:hover{box-shadow:var(--shadow); transform:translateY(-1px);}
  .item-card:focus-visible{outline:2px solid var(--accent-plant); outline-offset:2px;}
  .item-card .name{font-weight:700; font-size:14.5px;}
  .item-card .teaser{font-size:12.5px; color:var(--text-muted); overflow:hidden; text-overflow:ellipsis; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical;}
  .item-card .chip{align-self:flex-start; font-family:'IBM Plex Mono',monospace; font-size:10px; letter-spacing:.02em; padding:2px 7px; border-radius:20px;}
  [data-mode="materials"] .item-card .chip{background:var(--accent-material-soft); color:var(--accent-material);}
  [data-mode="plants"] .item-card .chip{background:var(--accent-plant-soft); color:var(--accent-plant);}

  .empty-note{color:var(--text-muted); font-size:14px; padding:30px 4px;}

  /* ---------- Modal detail ---------- */
  .backdrop{
    position:fixed; inset:0; background:rgba(10,14,10,.45); backdrop-filter:blur(2px);
    display:flex; align-items:flex-start; justify-content:center; padding:6vh 16px;
    z-index:100; overflow-y:auto;
  }
  .modal{
    background:var(--surface); border-radius:16px; max-width:600px; width:100%;
    box-shadow:0 20px 60px rgba(0,0,0,.35); border:1px solid var(--border);
    animation:pop .16s ease;
  }
  @keyframes pop{from{opacity:0; transform:translateY(6px) scale(.99);} to{opacity:1; transform:none;}}
  .modal-head{display:flex; align-items:flex-start; justify-content:space-between; gap:14px; padding:22px 24px 14px; border-bottom:1px solid var(--border);}
  .modal-head h3{font-size:21px; margin:0 0 6px;}
  .modal-head .chip{display:inline-block; font-family:'IBM Plex Mono',monospace; font-size:11px; padding:3px 9px; border-radius:20px;}
  [data-mode="materials"] .modal-head .chip{background:var(--accent-material-soft); color:var(--accent-material);}
  [data-mode="plants"] .modal-head .chip{background:var(--accent-plant-soft); color:var(--accent-plant);}
  .modal-close{appearance:none; border:none; background:var(--surface-2); width:32px; height:32px; border-radius:50%; cursor:pointer; flex:none; font-size:16px; line-height:1;}
  .modal-body{padding:16px 24px 26px; display:flex; flex-direction:column; gap:14px;}
  .field-row .label{font-family:'IBM Plex Mono',monospace; font-size:11px; text-transform:uppercase; letter-spacing:.06em; color:var(--text-muted); margin-bottom:3px;}
  .field-row .value{font-size:14.5px;}
  .modal-body ul{margin:0; padding-left:1.1em; display:flex; flex-direction:column; gap:6px;}
  .modal-body li{font-size:14.5px;}

  /* ---------- Quiz ---------- */
  .quiz-wrap{margin-top:26px; max-width:640px;}
  .quiz-card{background:var(--surface); border:1px solid var(--border); border-radius:16px; padding:26px 26px 24px; box-shadow:var(--shadow);}
  .quiz-setting-row{display:flex; flex-direction:column; gap:8px; margin-bottom:20px;}
  .quiz-setting-row .label{font-size:13px; font-weight:600; color:var(--text-muted);}
  .pillset{display:flex; gap:8px; flex-wrap:wrap;}
  .pill{
    appearance:none; cursor:pointer; border:1px solid var(--border); background:var(--surface-2);
    border-radius:20px; padding:7px 15px; font-size:13.5px; color:var(--text);
  }
  .pill[data-active="true"]{background:var(--accent-quiz); border-color:var(--accent-quiz); color:#fff;}
  .checkgrid{display:grid; grid-template-columns:repeat(auto-fill,minmax(180px,1fr)); gap:8px; margin-top:4px;}
  .checkchip{
    display:flex; align-items:center; gap:9px; text-align:left; cursor:pointer;
    border:1px solid var(--border); background:var(--surface-2); border-radius:10px; padding:9px 12px; font-size:13.5px;
  }
  .checkchip .box{
    flex:none; width:16px; height:16px; border-radius:5px; border:1.5px solid var(--border);
    display:flex; align-items:center; justify-content:center; font-size:11px; color:#fff;
    background:var(--surface);
  }
  .checkchip[data-active="true"]{border-color:var(--accent-quiz); background:var(--accent-quiz-soft);}
  .checkchip[data-active="true"] .box{background:var(--accent-quiz); border-color:var(--accent-quiz);}
  .checkchip span:nth-child(2){flex:1;}
  .checkchip .n{flex:none; font-family:'IBM Plex Mono',monospace; font-size:10.5px; color:var(--text-muted);}
  .btn-primary{
    appearance:none; cursor:pointer; border:none; background:var(--accent-quiz); color:#fff;
    border-radius:11px; padding:13px 20px; font-size:15px; font-weight:700; width:100%;
  }
  .btn-primary:hover{filter:brightness(1.05);}
  .btn-ghost{
    appearance:none; cursor:pointer; border:1px solid var(--border); background:none; color:var(--text);
    border-radius:11px; padding:11px 18px; font-size:14px; font-weight:600;
  }
  .qz-top{display:flex; align-items:center; justify-content:space-between; margin-bottom:16px; gap:14px;}
  .qz-progress{font-family:'IBM Plex Mono',monospace; font-size:12.5px; color:var(--text-muted);}
  .qz-score{font-family:'IBM Plex Mono',monospace; font-size:12.5px; color:var(--accent-quiz); font-weight:600;}
  .progress-bar{height:5px; border-radius:4px; background:var(--surface-2); overflow:hidden; margin-bottom:20px;}
  .progress-bar > div{height:100%; background:var(--accent-quiz);}
  .qz-tag{display:inline-block; font-family:'IBM Plex Mono',monospace; font-size:10.5px; padding:2px 8px; border-radius:20px; margin-bottom:10px;}
  .qz-tag.plant{background:var(--accent-plant-soft); color:var(--accent-plant);}
  .qz-tag.material{background:var(--accent-material-soft); color:var(--accent-material);}
  .qz-question{font-size:17px; font-weight:600; margin:0 0 18px; text-wrap:balance;}
  .options{display:flex; flex-direction:column; gap:9px; margin-bottom:6px;}
  .opt{
    text-align:left; display:flex; gap:11px; align-items:flex-start;
    border:1px solid var(--border); background:var(--surface-2); border-radius:11px;
    padding:12px 14px; cursor:pointer; font-size:14.5px;
  }
  .opt:hover:not([disabled]){border-color:var(--accent-quiz);}
  .opt .k{font-family:'IBM Plex Mono',monospace; font-weight:700; color:var(--text-muted); flex:none;}
  .opt[data-state="correct"]{background:var(--good-soft); border-color:var(--good);}
  .opt[data-state="correct"] .k{color:var(--good);}
  .opt[data-state="wrong"]{background:var(--bad-soft); border-color:var(--bad);}
  .opt[data-state="wrong"] .k{color:var(--bad);}
  .opt[disabled]{cursor:default;}
  .feedback{display:flex; align-items:center; gap:8px; font-size:13.5px; font-weight:700; margin:14px 0 4px;}
  .feedback.correct{color:var(--good);}
  .feedback.wrong{color:var(--bad);}
  .qz-actions{display:flex; justify-content:flex-end; margin-top:10px;}

  .summary-score{display:flex; align-items:baseline; gap:10px; margin-bottom:6px;}
  .summary-score .big{font-family:'Noto Serif TC',serif; font-size:44px; font-weight:700; color:var(--accent-quiz);}
  .summary-score .of{font-size:15px; color:var(--text-muted);}
  .summary-msg{color:var(--text-muted); font-size:14px; margin-bottom:20px;}
  .review-list{display:flex; flex-direction:column; gap:10px; margin:18px 0 22px; max-height:340px; overflow-y:auto;}
  .review-item{border:1px solid var(--border); border-radius:10px; padding:11px 13px; font-size:13px;}
  .review-item .q{font-weight:600; margin-bottom:4px;}
  .review-item .a{color:var(--good);}
  .review-item .a.wrong-was{color:var(--bad); text-decoration:line-through; margin-right:6px;}

  footer{margin-top:56px; padding-top:18px; border-top:1px solid var(--border); color:var(--text-muted); font-size:12.5px; line-height:1.8;}
</style>

<div class="app">
  <div class="topbar">
    <div class="topbar-inner">
      <div class="brand">
        <span class="brand-mark">造</span>
        <h1>造園識別圖鑑</h1>
        <span class="sub">乙級技術士技能檢定 · 識別學科</span>
      </div>
      <nav class="tabs" id="tabs"></nav>
    </div>
  </div>
  <div id="root" style="margin-top:4px;"></div>
  <footer>
    資料整理自勞動部勞動力發展署技能檢定中心造園景觀乙級技能檢定識別參考資料，僅供學科識別練習使用，請以最新公告版本為準。
